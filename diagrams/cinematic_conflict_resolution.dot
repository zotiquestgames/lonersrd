digraph cinematic_conflict_resolution {
    label = "CONFLICT RESOLUTION: WHICH METHOD?";
    labelloc="t";
    fontname="Permanent Marker";
    bgcolor=white;
    dpi=300;
    node [shape="rect", fontname="Permanent Marker", fontsize=12];
    edge [fontname="Permanent Marker", fontsize=12];

    q1  [label="BRIEF OR\nONE-SIDED?"];
    q2  [label="FOCUS OF\nTHIS SCENE?"];
    q3  [label="CINEMATIC\nWITH STUNTS?"];
    q4  [label="NEED DETAILED\nTRACKING?"];

    single   [label="SINGLE\nORACLE QUESTION"];
    stunt    [label="STUNT-BASED\n+ HARM & LUCK"];
    hl       [label="HARM & LUCK\nTRACKING"];
    action   [label="ACTION-BY-ACTION"];

    q1 -> single [label="Yes"];
    q1 -> q2     [label="No"];
    q2 -> single [label="No"];
    q2 -> q3     [label="Yes"];
    q3 -> stunt  [label="Yes"];
    q3 -> q4     [label="No"];
    q4 -> hl     [label="Yes"];
    q4 -> action [label="No"];
}
