digraph cinematic_action_cycle {
    label = "THE CINEMATIC ACTION CYCLE";
    labelloc="t";
    fontname="Permanent Marker";
    bgcolor=white;
    dpi=300;
    node [shape="rect", fontname="Permanent Marker", fontsize=12];
    edge [fontname="Permanent Marker", fontsize=12];

    action      [label="ACTION\nFight, chase,\nor heist"];
    consequence [label="CONSEQUENCE\nHurt, betrayed,\nor escalated"];
    reflection  [label="REFLECTION\nQuiet moment\nto process"];
    next        [label="NEXT ACTION\nStakes rise\nmomentum builds"];

    action      -> consequence [label="Oracle resolves"];
    consequence -> reflection  [label="Story interprets"];
    reflection  -> next        [label="Protagonist\nplans"];
    next        -> action      [label="Escalated"];
}
