digraph timeweb_assassin {
    label = "THE LOOPING ASSASSIN";
    labelloc="t";
    fontname="Permanent Marker";
    rankdir=LR;
    node [fontname="Permanent Marker", fontsize=12];
    edge [fontname="Permanent Marker", fontsize=12];

    F1 [label="F1\nTHE AMBASSADOR\nIS DEAD", shape="rectangle"];
    C1 [label="C1\nBRIEFING ROOM", shape="circle", style="filled", fillcolor="black", fontcolor="white"];
    C2 [label="C2\nROOFTOP", shape="circle", style="filled", fillcolor="black", fontcolor="white"];
    C3 [label="C3", shape="circle", style="filled", fillcolor="black", fontcolor="white"];

    {rank=same; F1; C1}
    F1 -> C1 [dir="none", style="dotted"];
    C1 -> C2 -> C3;
    C1 -> C1 [label="↺ x3", constraint=false, style="dashed"];
    C2 -> C2 [label="↺ x2", constraint=false, style="dashed"];
}
