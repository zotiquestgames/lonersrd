digraph quiet_moments_session_flow {
    label = "SESSION FLOW";
    labelloc="t";
    fontname="Permanent Marker";
    node [shape="rect", fontname="Permanent Marker", fontsize=12];
    edge [fontname="Permanent Marker", fontsize=12];
    bgcolor=white;
    dpi=300;

    ctx [label="SET CONTEXT\nROLL ENERGY TAG\nNOTE SEASON OR WEATHER\nONLY IF IT MATTERS"];
    Frame [label="FRAME SCENE\nWHERE · WHO · WHAT"];
    Ask [label="OUTCOME UNCERTAIN?\nASK THE ORACLE"];
    Tags [label="RELEVANT TAGS ONLY\nMAX 2 DICE\nOPPOSING TAGS CANCEL"];
    outcome [label="INTERPRET RESULT\nYES / NO + AND / BUT"];
    Doubles [label="DOUBLES?\nADD 1 TO TWIST COUNTER"];
    Twist3 [label="TWIST COUNTER AT 3?"];
    Twist [label="TRIGGER TWIST\nROLL SUBJECT + ACTION"];
    ConflictQ [label="IS THIS A CONFLICT?"];
    ConflictMode [label="CHOOSE METHOD\nSINGLE QUESTION\nSERIES OF QUESTIONS\nHARM & LUCK"];
    Stake [label="NAME THE STAKE\nPRACTICAL · INNER · BOND"];
    Resolve [label="RESOLVE CONFLICT\nLUCK RESETS TO 6"];
    Mark [label="LASTING MARK?\nFILL STATUS TRACK BOX"];
    Maintain [label="MAINTAIN RHYTHMS\nADJUST ENERGY\nCLEAR STATUS TAGS"];
    Close [label="CLOSE SCENE\nRESOLVED · BLOCKED · ABANDONED"];
    NextScene [label="SCENE TRANSITION\n1–3 LINGERING\n4–5 BREATHING · 6 MEANWHILE"];
    End [label="END STORY\nADD OR MODIFY A TRAIT\nUPDATE THE LIVING WORLD"];

    ctx -> Frame;
    Frame -> Ask;
    Tags -> Ask [style=dotted, label="informs"];
    Ask -> outcome;
    outcome -> Doubles;
    Doubles -> Twist3 [label="Yes"];
    Doubles -> ConflictQ [label="No", style=dashed];
    Twist3 -> Twist [label="Yes"];
    Twist -> ConflictQ;
    Twist3 -> ConflictQ [label="No"];
    ConflictQ -> ConflictMode [label="Yes"];
    ConflictQ -> Maintain [label="No"];
    ConflictMode -> Stake [label="Harm & Luck"];
    ConflictMode -> Resolve [label="Questions", style=dashed];
    Stake -> Resolve;
    Resolve -> Mark;
    Mark -> Maintain;
    Maintain -> Close;
    Close -> NextScene;
    NextScene -> Frame [label="Loop"];
    Close -> End [label="Arc done", style=dashed];
}
