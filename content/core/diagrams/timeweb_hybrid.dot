digraph timeweb_hybrid {
    label = "HYBRID GAME";
    labelloc="t";
    fontname="Permanent Marker";
    rankdir=LR;
    node [fontname="Permanent Marker", fontsize=12];
    edge [fontname="Permanent Marker", fontsize=12];

    F2 [label="F2", shape="rectangle"];
    C1 [label="C1", shape="circle", style="filled", fillcolor="black", fontcolor="white"];
    C2 [label="C2", shape="circle", style="filled", fillcolor="black", fontcolor="white"];
    L1 [label="L1\n✶", shape="circle"];
    L2 [label="L2\n✶✶✶", shape="circle"];
    COLLAPSE [label="COLLAPSE\nFALLOUT", shape="rectangle", style="dashed"];

    {rank=same; F2; C2}
    F2 -> C2 [dir="none", style="dotted"];
    C1 -> C1 [label="↺ x2", constraint=false, style="dashed"];
    C1 -> C2 -> L1;
    L1 -> L2 -> COLLAPSE [style="dashed"];
}
